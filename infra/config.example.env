# ---- which AWS account -------------------------------------------------------
# Named profile from ~/.aws/credentials. Leave empty to use the default profile.
PROFILE=home
REGION=us-east-1

# ---- naming ------------------------------------------------------------------
# Used for the Lambda, DynamoDB table, HTTP API and schedule. Change it only if
# you deploy two lists into the SAME account.
APP=todo-list

# ---- how you get reminded ----------------------------------------------------
# Comma list: email, push, or both. Web push needs no email at all — useful if
# your provider rejects SES mail sent as your own address (Yahoo, for one, has
# DMARC p=reject, so From: you@yahoo.com via SES is refused).
CHANNELS=push

# Filled in automatically on the first deploy with push enabled. Rotating these
# silently unsubscribes every device, so keep them.
VAPID_PUBLIC=
VAPID_PRIVATE=

# ---- email -------------------------------------------------------------------
# Sender and recipient, used only when CHANNELS includes "email". SES starts in
# sandbox mode, where both must be verified — using one address for both means
# verifying exactly one thing. Still set it with push-only: it is the contact
# address in the VAPID claim your browser vendor sees.
EMAIL=you@example.com
TIMEZONE=America/Los_Angeles       # only affects times printed in reminder emails
SWEEP="rate(5 minutes)"            # worst-case reminder lag; 1 minute also stays free

# ---- front door --------------------------------------------------------------
# auto  = try a Lambda Function URL (always free), fall back to API Gateway
# url   = force Function URL
# apigw = force API Gateway HTTP API
FRONTDOOR=auto

# ---- secrets (generated for you on first run; keep this file private) --------
PASSWORD=
TOKEN_SECRET=
